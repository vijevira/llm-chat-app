{
  "antigravityignore-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node ~/.gemini/config/scripts/security-guard.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}